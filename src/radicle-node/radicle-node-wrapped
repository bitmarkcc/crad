#!/bin/bash
#
# Run the Rust-based rad node inside a bubblewrap sandbox.
#
# By default, all network traffic is forced through Tor.
# Use --clearnet to connect directly without Tor.
#
# Requirements:
#   Default (Tor): bwrap, slirp4netns, torsocks, tor (on host at 127.0.0.1)
#   Clearnet:      bwrap, slirp4netns
#

set -e

use_tor=true

if [ -n "$CRAD_HOME" ] && [ -n "$RAD_HOME" ]
then
    export PATH="$CRAD_HOME/bin:$RAD_HOME/bin:$PATH"
fi

rad_home="`crad self --node-home`"
crad_home="`crad self --home`"

network_mode="`crad self --network-mode`"
if [[ "$network_mode" == "clearnet" ]]
then
   use_tor=false
fi

args=()
for arg in "$@"; do
    if [ "$arg" = "--clearnet" ]; then
        use_tor=false
    else
        args+=("$arg")
    fi
done

# Write marker file indicating Tor/clearnet mode
mkdir -p "$crad_home/node"
if [ "$use_tor" == true ]; then
    echo "tor" > "$crad_home/node/network-mode"
else
    echo "clearnet" > "$crad_home/node/network-mode"
fi

set +e
cradicle-node
set -e

onion_addr=""
hs_hostname="$crad_home/tor/hidden_service/hostname"
if [ -f "$hs_hostname" ]; then
    onion_addr="$(cat "$hs_hostname" | tr -d '[:space:]')"
fi

tor_socks_port=9050
if [ -f "$crad_home/tor/socks_port" ]; then
    tor_socks_port="$(cat "$crad_home/tor/socks_port" | tr -d '[:space:]')"
fi

if [ "$use_tor" = true ]; then
    # Ensure radicle config has proxy/onion/seeding settings for the bwrap sandbox,
    # where Tor is reachable at 10.0.2.2:$tor_socks_port via the slirp4netns gateway.
    python3 -c "
import json, os
cfg = '$rad_home/config.json'
onion_addr = '$onion_addr'
tor_port = '$tor_socks_port'
if os.path.exists(cfg):
    with open(cfg) as f: c = json.load(f)
    node = c.setdefault('node', {})
    changed = False
    proxy = '10.0.2.2:' + tor_port
    if node.get('proxy') != proxy:
        node['proxy'] = proxy
        changed = True
    onion = {'mode': 'proxy', 'address': proxy}
    if node.get('onion') != onion:
        node['onion'] = onion
        changed = True
    seeding = {'default': 'block'}
    if node.get('seedingPolicy') != seeding:
        node['seedingPolicy'] = seeding
        changed = True
    listen = ['0.0.0.0:8776']
    if node.get('listen') != listen:
        node['listen'] = listen
        changed = True
    if onion_addr:
        ext = [onion_addr + ':8776']
        if node.get('externalAddresses') != ext:
            node['externalAddresses'] = ext
            changed = True
    if changed:
        with open(cfg, 'w') as f: json.dump(c, f, indent=2); f.write('\n')
"
else
    # Remove proxy/onion settings for clearnet mode, keep seeding policy
    python3 -c "
import json, os
cfg = '$rad_home/config.json'
onion_addr = '$onion_addr'
if os.path.exists(cfg):
    with open(cfg) as f: c = json.load(f)
    node = c.get('node', {})
    changed = False
    if 'proxy' in node:
        del node['proxy']
        changed = True
    if 'onion' in node:
        del node['onion']
        changed = True
    seeding = {'default': 'block'}
    if node.get('seedingPolicy') != seeding:
        node['seedingPolicy'] = seeding
        changed = True
    if onion_addr:
        listen = ['0.0.0.0:8776']
        if node.get('listen') != listen:
            node['listen'] = listen
            changed = True
        ext = [onion_addr + ':8776']
        if node.get('externalAddresses') != ext:
            node['externalAddresses'] = ext
            changed = True
    if changed:
        with open(cfg, 'w') as f: json.dump(c, f, indent=2); f.write('\n')
"
fi

# --- Sandboxed rad node ---
# From here on, disable set -e to avoid subtle interactions with
# background processes, wait, and signal handling.
set +e

info_pipe=$(mktemp -u)
mkfifo "$info_pipe"

cleanup() {
    [ -n "$slirp_pid" ] && kill "$slirp_pid" 2>/dev/null
    [ -n "$bwrap_pid" ] && kill "$bwrap_pid" 2>/dev/null
    rm -f "$info_pipe"
    rm -f "$crad_home/node/network-mode"
    exec 4<&- 2>/dev/null
}
trap cleanup EXIT INT TERM

if [ "$use_tor" = true ]; then
    node_cmd='
        for _ in $(seq 1 50); do
            ip link show tap0 >/dev/null 2>&1 && break
            sleep 0.1
        done
        exec torsocks rad node start "$@"
    '
    tor_env=(
        --setenv TORSOCKS_TOR_ADDRESS "10.0.2.2"
        --setenv TORSOCKS_TOR_PORT "$tor_socks_port"
        --setenv TORSOCKS_ALLOW_INBOUND "1"
    )
    if [ -f "$rad_home/lib/libtorsocks.so" ]; then
        tor_env+=(--setenv TORSOCKS_LIBRARY "/tmp/.radicle/lib/libtorsocks.so")
    fi
else
    node_cmd='
        for _ in $(seq 1 50); do
            ip link show tap0 >/dev/null 2>&1 && break
            sleep 0.1
        done
        exec rad node start "$@"
    '
    tor_env=()
fi

bwrap \
    --json-status-fd 3 \
    --ro-bind /usr /usr \
    --ro-bind /bin /bin \
    --ro-bind /lib /lib \
    --ro-bind /lib64 /lib64 \
    --ro-bind /etc /etc \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --clearenv \
    --unshare-all \
    --uid 0 --gid 0 \
    --bind "$rad_home" /tmp/.radicle \
    --chdir /tmp \
    --setenv HOME "/tmp" \
    --setenv PATH "/tmp/bin:/tmp/.radicle/bin:/usr/bin:/bin" \
    --setenv LANG "$LANG" \
    --setenv TERM "$TERM" \
    --setenv RAD_PASSPHRASE "$RAD_PASSPHRASE" \
    "${tor_env[@]}" \
    -- sh -c "$node_cmd" _ "${args[@]}" \
    3>"$info_pipe" &

bwrap_pid=$!

# Keep the FIFO read end open on fd 4 to prevent SIGPIPE killing bwrap
# when it writes a second JSON status after its child exits.
exec 4< "$info_pipe"
child_pid=$(python3 -c "import json,sys; print(json.loads(sys.stdin.readline())['child-pid'])" <&4)

if [ -z "$child_pid" ]; then
    echo "Error: failed to read child PID from bwrap" >&2
    exit 1
fi

slirp4netns --configure --mtu=65520 --enable-ipv6 --userns-path="/proc/$child_pid/ns/user" "$child_pid" tap0 &
slirp_pid=$!

# Wait for the sandboxed node to exit. Use a poll loop so that
# transient signal interruptions or bwrap parent exiting don't
# cause the script to exit and kill slirp4netns prematurely.
while kill -0 "$child_pid" 2>/dev/null; do
    wait "$bwrap_pid" 2>/dev/null || true
    sleep 1
done
