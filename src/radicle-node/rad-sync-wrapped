#!/bin/bash
#
# Sync a repository to the Radicle network via the running rad node.
# rad commands run in a filesystem-isolated sandbox. No network access
# is needed — communication with the node is via the control socket.
#
# Requirements: bwrap, rad node must be running (via radicle-node-wrapped)
#

set -e

if [ -n "$CRAD_HOME" ] && [ -n "$RAD_HOME" ]
then
    export PATH="$CRAD_HOME/bin:$RAD_HOME/bin:$PATH"
fi

crad_home="`crad self --home`"
rad_home="`crad self --node-home`"

# Resolve the RID: from argument or from CWD
rid="$1"
if [ -z "$rid" ]; then
    rid="`crad inspect --rid | awk '{print $2}'`"
fi

if [ -z "$rid" ]; then
    echo "Error: no RID specified and none found in current directory" >&2
    exit 1
fi

# Strip rad: prefix for storage paths
repo_id="${rid#rad:}"
crad_repo="$crad_home/storage/$repo_id"
rad_repo="$rad_home/storage/$repo_id"

# Get crad NID
crad_nid="$(crad self --did)"
crad_nid="${crad_nid#did:key:}"

# Check if we are the delegate (our NID has signed refs in this repo)
is_delegate=false
if [ -d "$crad_repo" ] && git --git-dir="$crad_repo" rev-parse "refs/namespaces/$crad_nid/refs/rad/sigrefs" >/dev/null 2>&1; then
    is_delegate=true
fi

if [ "$is_delegate" = true ]; then
    # Delegate: push our refs to rad storage before fetching/announcing
    if [ -d "$crad_repo" ]; then
        if [ ! -d "$rad_repo" ]; then
            cp -a "$crad_repo" "$rad_repo"
        else
            git --git-dir="$rad_repo" fetch "$crad_repo" '+refs/*:refs/*' 2>/dev/null
        fi
    fi
fi

# Seed the repo (local policy update, no network needed)
bwrap \
    --ro-bind /usr /usr \
    --ro-bind /bin /bin \
    --ro-bind /lib /lib \
    --ro-bind /lib64 /lib64 \
    --ro-bind /etc /etc \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --clearenv \
    --unshare-all \
    --uid 0 --gid 0 \
    --bind "$rad_home" /tmp/.radicle \
    --chdir /tmp \
    --setenv HOME "/tmp" \
    --setenv PATH "/tmp/.radicle/bin:/usr/bin:/bin" \
    --setenv LANG "$LANG" \
    --setenv TERM "$TERM" \
    -- rad seed --no-fetch "$rid"

if [ "$is_delegate" = true ]; then
# Add repo to node's inventory and announce to peers via control socket.
# rad seed only updates seeding policy, not the node's runtime inventory.
bwrap \
    --ro-bind /usr /usr \
    --ro-bind /bin /bin \
    --ro-bind /lib /lib \
    --ro-bind /lib64 /lib64 \
    --ro-bind /etc /etc \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --clearenv \
    --unshare-all \
    --uid 0 --gid 0 \
    --bind "$rad_home" /tmp/.radicle \
    --chdir /tmp \
    --setenv HOME "/tmp" \
    --setenv PATH "/tmp/.radicle/bin:/usr/bin:/bin" \
    --setenv LANG "$LANG" \
    --setenv TERM "$TERM" \
    -- python3 -c "
import socket, json, sys
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect('/tmp/.radicle/node/control.sock')
sock.sendall((json.dumps({'command': 'addInventory', 'rid': 'rad:' + sys.argv[1]}) + '\n').encode())
resp = sock.makefile().readline()
sock.close()
result = json.loads(resp)
if 'error' in result:
    print('addInventory failed: ' + result.get('reason', resp), file=sys.stderr)
    sys.exit(1)
print('addInventory: ' + resp.strip(), file=sys.stderr)
" "$repo_id"
fi

# Fetch latest refs from the network
bwrap \
    --ro-bind /usr /usr \
    --ro-bind /bin /bin \
    --ro-bind /lib /lib \
    --ro-bind /lib64 /lib64 \
    --ro-bind /etc /etc \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --clearenv \
    --unshare-all \
    --uid 0 --gid 0 \
    --bind "$rad_home" /tmp/.radicle \
    --chdir /tmp \
    --setenv HOME "/tmp" \
    --setenv PATH "/tmp/.radicle/bin:/usr/bin:/bin" \
    --setenv LANG "$LANG" \
    --setenv TERM "$TERM" \
    -- rad sync --fetch "rad:$repo_id"

if [ "$is_delegate" = true ]; then
    # Announce the crad delegate's refs via the node's control socket.
    # The sigrefs are already signed by crad and synced to rad storage.
    bwrap \
        --ro-bind /usr /usr \
        --ro-bind /bin /bin \
        --ro-bind /lib /lib \
        --ro-bind /lib64 /lib64 \
        --ro-bind /etc /etc \
        --proc /proc \
        --dev /dev \
        --tmpfs /tmp \
        --clearenv \
        --unshare-all \
        --uid 0 --gid 0 \
        --bind "$rad_home" /tmp/.radicle \
        --chdir /tmp \
        --setenv HOME "/tmp" \
        --setenv PATH "/tmp/.radicle/bin:/usr/bin:/bin" \
        --setenv LANG "$LANG" \
        --setenv TERM "$TERM" \
        -- python3 -c "
import socket, json, sys
sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
sock.connect('/tmp/.radicle/node/control.sock')
cmd = json.dumps({'command': 'announceRefsFor', 'rid': 'rad:' + sys.argv[1], 'namespaces': [sys.argv[2]]})
sock.sendall((cmd + '\n').encode())
resp = sock.makefile().readline()
sock.close()
result = json.loads(resp)
if 'error' in result:
    print('Announce failed: ' + result.get('reason', resp), file=sys.stderr)
    sys.exit(1)
print('Announced refs for ' + sys.argv[2], file=sys.stderr)
" "$repo_id" "$crad_nid"
fi
