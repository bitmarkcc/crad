#!/bin/bash
#
# Run rad clone inside a bubblewrap sandbox. No network access is needed —
# the running rad node (via radicle-node-wrapped) handles the actual fetch.
# rad clone communicates with the node via the control socket.
#
# Requirements: bwrap, rad node must be running (via radicle-node-wrapped)
#

set -e

if [ -n "$CRAD_HOME" ] && [ -n "$RAD_HOME" ]
then
    export PATH="$CRAD_HOME/bin:$RAD_HOME/bin:$PATH"
fi

dir="$2"

mkdir -p "$dir"

rad_home="`crad self --node-home`"

bwrap \
    --ro-bind /usr /usr \
    --ro-bind /bin /bin \
    --ro-bind /lib /lib \
    --ro-bind /lib64 /lib64 \
    --ro-bind /etc /etc \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --clearenv \
    --unshare-all \
    --uid 0 --gid 0 \
    --bind "$rad_home" /tmp/.radicle \
    --bind "$dir" "/tmp/$dir" \
    --chdir /tmp \
    --setenv HOME "/tmp" \
    --setenv PATH "/tmp/.radicle/bin:/usr/bin:/bin" \
    --setenv LANG "$LANG" \
    --setenv TERM "$TERM" \
    -- rad clone "$@"
