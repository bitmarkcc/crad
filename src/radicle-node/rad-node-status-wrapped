#!/bin/bash
#
# Query rad node status inside a bwrap sandbox.
# Communicates with the node via the control socket — no network needed.
#
# Requirements: bwrap, rad node must be running (via radicle-node-wrapped)
#

set -e

if [ -n "$CRAD_HOME" ] && [ -n "$RAD_HOME" ]
then
    export PATH="$CRAD_HOME/bin:$RAD_HOME/bin:$PATH"
fi

rad_home="`crad self --node-home`"

bwrap \
    --ro-bind /usr /usr \
    --ro-bind /bin /bin \
    --ro-bind /lib /lib \
    --ro-bind /lib64 /lib64 \
    --ro-bind /etc /etc \
    --proc /proc \
    --dev /dev \
    --tmpfs /tmp \
    --clearenv \
    --unshare-all \
    --uid 0 --gid 0 \
    --bind "$rad_home" /tmp/.radicle \
    --chdir /tmp \
    --setenv HOME "/tmp" \
    --setenv PATH "/tmp/.radicle/bin:/usr/bin:/bin" \
    --setenv LANG "$LANG" \
    --setenv TERM "$TERM" \
    -- rad node status "$@"
